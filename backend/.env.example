# Backend environment (local development)
PORT=5001
NODE_ENV=development

# Anti-sleep keep-alive (Render sets RENDER_EXTERNAL_URL automatically)
RENDER_EXTERNAL_URL=
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL=10

# NVIDIA NIM (comma-separated pool enables rotation; falls back to repo defaults if unset)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEYS=nvapi-KEY1,nvapi-KEY2,nvapi-KEY3,nvapi-KEY4,nvapi-KEY5

# Neo4j AuraDB (leave empty to run the graph in Demo/Mock mode)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Cognee Python microservice bridge (defaults to http://localhost:8100 outside production)
COGNEE_SERVICE_URL=http://localhost:8100

# Render Workflows REST trigger (omit to disable /api/workflow/trigger)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=DEBUG

# Tavily web search (format tvly-...; get one at app.tavily.com)
TAVILY_API_KEY=

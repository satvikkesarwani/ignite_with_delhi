# Cognee Cognitive Memory Service (services/cognee-service)

# Neo4j AuraDB — leave empty to use the embedded local Ladybug graph (zero setup)
GRAPH_DATABASE_URL=
GRAPH_DATABASE_USERNAME=neo4j
GRAPH_DATABASE_PASSWORD=

# Embeddings (zero-cost local ONNX, no API needed)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DB_PROVIDER=lancedb

# Token chunking (300-500 for forensic density, 1500 for broad context)
CHUNK_SIZE=500
CHUNK_OVERLAP=10
CHUNK_ENGINE=token

# LLM (NVIDIA NIM via OpenAI-compatible endpoint; key falls back to the repo pool)
LLM_PROVIDER=openai
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
LLM_API_KEY=

# Access control (single-tenant hackathon mode)
ENABLE_BACKEND_ACCESS_CONTROL=false
